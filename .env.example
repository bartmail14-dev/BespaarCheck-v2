# Contactformulier gebruikt tijdelijk mailto.
# Later vervangen door een Mailgun/Vercel API-route.

# Server-side LLM configuratie voor /api/chat.
# Zet echte keys alleen in .env.local of hosting-secrets, nooit in Git.
CHAT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Gemini alternatief. Zet CHAT_PROVIDER=gemini om dit te gebruiken.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_CALCULATOR_MODEL=gemini-2.5-pro

# Optioneel: afwijkend endpoint voor de BespaarCheck chatbot.
# Zonder waarde gebruikt de frontend /api/chat. De chatbot valt niet lokaal terug.
# Test u via Vite zonder Vercel dev, zet hier bijvoorbeeld de Vercel API-url.
VITE_BESPAARCHECK_CHAT_ENDPOINT=

# Server-side Postmark configuratie voor /api/contact.
# Zet de echte token alleen in .env.local of hosting-secrets, nooit in Git.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=info@bespaarcheck.net
POSTMARK_MESSAGE_STREAM=outbound
CONTACT_TO_EMAIL=ict@comcamenergy.com
CHATBOT_TO_EMAIL=info@bespaarcheck.net
